<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>AAS journal style for Rubin documents</title>
    <id>https://lsst.io/styles/rubin-aas</id>
    <link href="https://lsst.io/styles/rubin-aas" rel="self"/>
    <link href="http://www.zotero.org/styles/the-astrophysical-journal" rel="template"/>
    <link href="https://journals.aas.org/manuscript-preparation/" rel="documentation"/>
    <author>
      <name>Rubin Observatory</name>
    </author>
    <contributor>
      <name>Chris Lowder</name>
    </contributor>
    <contributor>
      <name>Sebastian Karcher</name>
    </contributor>
    <summary>Author-year references following the aastex aasjournal style, with Rubin document handles rendered from the bibliography key because the shared Rubin bibliographies key entries by handle.</summary>
    <category citation-format="author-date"/>
    <category field="science"/>
    <updated>2026-07-18T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <macro name="author">
    <names variable="author">
      <name sort-separator=", " delimiter=", " and="symbol" initialize-with=". " delimiter-precedes-last="always" name-as-sort-order="all"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" sort-separator=", " delimiter=", " and="symbol" initialize-with=". " name-as-sort-order="all"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="year-date">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="editor">
    <choose>
      <if type="chapter paper-conference" match="any">
        <names variable="editor">
          <label form="short" plural="never" suffix=" "/>
          <name and="symbol" delimiter-precedes-last="always" initialize-with=". "/>
        </names>
      </if>
    </choose>
  </macro>
  <macro name="report-number">
    <!-- Rubin handles are the bibliography keys in the shared files; the
         number variable is unreliable because hyphenated report numbers do
         not round-trip through the bibliography processor. -->
    <group delimiter=" ">
      <text variable="genre"/>
      <text variable="citation-key"/>
    </group>
  </macro>
  <macro name="identifier">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi:"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>
  <citation collapse="year" et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <sort>
      <key macro="author-short"/>
    </sort>
    <layout delimiter="; " prefix="(" suffix=")">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="author-short"/>
          <text macro="year-date"/>
        </group>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="true" et-al-min="6" et-al-use-first="3" entry-spacing="0">
    <sort>
      <key macro="author"/>
      <key macro="year-date"/>
    </sort>
    <layout>
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="author"/>
          <text macro="year-date"/>
        </group>
        <text variable="title"/>
        <choose>
          <if type="report">
            <text macro="report-number"/>
            <choose>
              <if variable="authority">
                <text variable="authority"/>
              </if>
              <else>
                <text variable="publisher"/>
              </else>
            </choose>
          </if>
          <else-if type="article-journal article-magazine" match="any">
            <text variable="container-title" form="short"/>
            <text variable="volume"/>
            <text variable="page-first"/>
          </else-if>
          <else-if type="chapter paper-conference" match="any">
            <group delimiter=" ">
              <text term="in"/>
              <text variable="container-title"/>
            </group>
            <text macro="editor"/>
            <text variable="page-first"/>
            <text variable="publisher"/>
          </else-if>
          <else-if type="book">
            <group delimiter=": ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
          </else-if>
          <else-if type="software">
            <text variable="version" prefix="v"/>
          </else-if>
        </choose>
        <text macro="identifier"/>
      </group>
    </layout>
  </bibliography>
</style>
